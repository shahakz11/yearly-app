{
  "name": "auto-gifter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest --runInBand",
    "gas:login": "npx @google/clasp login",
    "gas:status": "npx @google/clasp status",
    "gas:pull": "npx @google/clasp pull",
    "gas:push": "npx @google/clasp push -f",
    "gas:deploy": "npx @google/clasp deploy",
    "gas:deploy:all": "npx clasp deploy -i AKfycbxj8A8nR6GWPae55H78tCM9g5d_pwzA7zMsdlcGAl6C8zdyjBBLVsV3Cwvy0vhwmtcI -d 'Auto-deploy Web App' && npx clasp deploy -i AKfycbz6HLaUuVMPfzcdryqjXcYRmtgCCifgWsFuq9HT8JRu5ghBB3q9UwLN2EFBHqKC9cRc -d 'Auto-deploy AddOn'",
    "gas:ship": "npm run gas:push && npm run gas:deploy:all"
  },
  "dependencies": {
    "expo": "~52.0.37",
    "expo-asset": "~11.0.5",
    "expo-calendar": "~14.0.6",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.7",
    "expo-contacts": "~14.0.4",
    "expo-linking": "~7.0.5",
    "expo-notifications": "~0.29.13",
    "expo-router": "~4.0.17",
    "expo-sharing": "~13.0.1",
    "expo-sqlite": "~15.0.6",
    "expo-status-bar": "~2.0.1",
    "expo-web-browser": "~14.0.2",
    "lucide-react-native": "^0.475.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@google/clasp": "^3.4.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.3.3"
  },
  "private": true
}
